---
import { getCollection } from "astro:content";
const allGuides = (await getCollection("guides")).sort((a, b) => a.data.order - b.data.order);
const [featured, ...rest] = allGuides;
---
<div id="guides" class="w-full bg-white px-6 md:px-14 lg:px-20 py-10 md:py-16 flex flex-col">
    <div class="flex flex-col gap-4">
        <span class="text-coral tracking-widest text-sm font-bold">RESOURCES</span>
        <h2 class="text-navy font-heading font-bold text-3xl">
            Guides to help you lead
        </h2>
    </div>

    <div class="w-full grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-8 py-10">

  <!-- Featured -->
<a href={`/guides/${featured.id}`} class="md:col-span-3 h-full md:bg-indigo flex flex-col group md:block rounded-xl overflow-hidden shadow-md hover:shadow-xl hover:-translate-y-1 hover:scale-[1.02] transition-all duration-200">
  <div class="md:grid grid-cols-[1fr_1.2fr] rounded-xl overflow-hidden min-h-48">
    <img src={featured.data.image} alt={featured.data.title} class="w-full h-40 md:h-full object-cover" />
    <div class="relative p-4 pb-14 md:p-8 flex flex-col md:justify-center md:gap-2 min-w-0">
      <span class="hidden md:block text-orange-500 font-bold text-xs py-2 tracking-wide">FEATURED GUIDE</span>
      <h3 class="font-heading font-bold text-sm uppercase md:text-xl wrap-break-word">{featured.data.title}</h3>
      <p class="text-sm text-slate-500">{featured.data.description}</p>
      <div class={`absolute inset-x-0 bottom-0 ${featured.data.labelBg} text-white text-sm font-semibold px-6 py-3 opacity-100 translate-y-0 md:opacity-0 md:translate-y-2 md:group-hover:opacity-100 md:group-hover:translate-y-0 transition-all duration-300`}>
        Learn More
      </div>
    </div>
  </div>
</a>

<!-- Row 2 -->
{rest.map((guide) => (
  <a href={`/guides/${guide.id}`} class="group h-full flex flex-col rounded-xl overflow-hidden shadow-lg hover:shadow-xl hover:-translate-y-1 hover:scale-[1.02] transition-all duration-200">
    <img src={guide.data.image} alt={guide.data.title} class="w-full h-48 md:h-40 object-cover" />
    <div class="relative flex-1 p-4 pb-14 min-w-0">
      <h4 class="font-heading font-bold text-sm">{guide.data.title.toUpperCase()}</h4>
      <p class="text-sm text-slate-500 mt-1">{guide.data.description}</p>
      <div class={`absolute inset-x-0 bottom-0 ${guide.data.labelBg} text-white text-sm font-semibold px-6 py-3 opacity-100 translate-y-0 md:opacity-0 md:translate-y-2 md:group-hover:opacity-100 md:group-hover:translate-y-0 transition-all duration-300`}>
        Learn More
      </div>
    </div>
  </a>
))}

    </div>
</div>