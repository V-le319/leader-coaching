---
import { resourceGuides } from "../data/cards";
const [featured, ...rest] = resourceGuides;
---
<div class="w-full bg-indigo px-6 md:px-20 py-12 md:py-16 flex flex-col">
    <div class="flex flex-col gap-4">
        <span class="text-coral tracking-widest text-sm font-bold">RESOURCES</span>
        <h2 class="text-navy font-heading font-bold text-3xl">
            Guides to help you lead
        </h2>
    </div>

    <div class="w-full grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-8 py-10">

  <!-- Featured -->
<a href={featured.href} class="md:col-span-3 h-full flex flex-col group md:block bg-emerald-50 rounded-xl overflow-hidden shadow-sm hover:shadow-xl transition-shadow duration-300">
  <div class="md:grid grid-cols-[1fr_1.2fr] bg-emerald-50 rounded-xl overflow-hidden min-h-40 md:min-h-55">
    <img src={featured.image} alt={featured.title} class="w-full h-48 md:h-full object-cover" />
    <div class="relative p-4 pb-14 md:p-8 flex flex-col md:justify-center md:gap-2">
      <span class="hidden md:block text-orange-500 font-bold text-xs py-2 tracking-wide">FEATURED GUIDE</span>
      <h3 class="font-heading font-bold text-sm uppercase md:text-xl">{featured.title}</h3>
      <p class="text-sm text-slate-500">{featured.description}</p>
      <div class={`absolute inset-x-0 bottom-0 ${featured.labelBg} text-white text-sm font-semibold px-6 py-3 opacity-100 translate-y-0 md:opacity-0 md:translate-y-2 md:group-hover:opacity-100 md:group-hover:translate-y-0 transition-all duration-300`}>
        Learn More
      </div>
    </div>
  </div>
</a>

<!-- Row 2 -->
{rest.map((guide) => (
  <a href={guide.href} class="group h-full flex flex-col rounded-xl overflow-hidden shadow-lg hover:shadow-xl transition-shadow duration-300">
    <img src={guide.image} alt={guide.title} class="w-full h-48 md:h-40 object-cover" />
    <div class="relative flex-1 p-4 pb-14">
      <h4 class="font-heading font-bold text-sm">{guide.title.toUpperCase()}</h4>
      <p class="text-sm text-slate-500 mt-1">{guide.description}</p>
      <div class={`absolute inset-x-0 bottom-0 ${guide.labelBg} text-white text-sm font-semibold px-6 py-3 opacity-100 translate-y-0 md:opacity-0 md:translate-y-2 md:group-hover:opacity-100 md:group-hover:translate-y-0 transition-all duration-300`}>
        Learn More
      </div>
    </div>
  </a>
))}

    </div>
</div>