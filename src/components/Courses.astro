---
import { getCollection } from "astro:content";
const allCourses = (await getCollection("courses")).sort((a, b) => a.data.order - b.data.order);
---
<div id="courses" class="w-full bg-indigo px-6 md:px-14 lg:px-20 py-10 md:py-16 flex flex-col gap-2">
    <div class="flex flex-col gap-4">
        <span class="text-coral tracking-widest text-sm font-bold">COACHING</span>
        <h2 class="text-navy font-heading font-bold text-3xl">
            Courses built for new leaders
        </h2>
    </div>

    <div class="w-full grid grid-cols-2 md:grid-cols-4 gap-4 xl:gap-10 py-6">   
    {allCourses.map((course) => (
        <a href={`/courses/${course.id}`} class="lg:h-40 flex flex-col md:justify-center hover:-translate-y-1 hover:scale-[1.05] transition-all gap-2 p-4 bg-white rounded-xl shadow-md hover:shadow-lg duration-200">
                <span class={`h-1 w-8 ${course.data.accentColor} rounded-full`}></span>
                <h4 class="font-heading font-bold text-base pt-2 md:text-xl">{course.data.title}</h4>
                <p class="text-xs text-slate-500">{course.data.description}</p>
            </a>
    ))}
    </div>
</div>