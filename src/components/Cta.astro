<div id="cta" class="bg-navy relative w-full px-6 md:px-20 py-16  grid grid-cols-1 md:grid-cols-2 gap-10 md:gap-28">

        <div class="left-info w-full flex flex-col  gap-4">
            <h2 class="font-heading text-3xl text-white font-bold">What kind of leader are you?</h2>
            <span class="text-white/60 font-body text-sm tracking-wide">Take our mini-course and find your leader style.</span>
            
           <div class="flex flex-col gap-3 md:gap-4 my-2"> 
                <input class="h-10 bg-white rounded-md py-2 px-4"
                    placeholder="First Name"/>
                <input class="h-10 bg-white rounded-md py-2 px-4"
                    placeholder="Email Address"/>
            </div>

            <button class="bg-turquoise mb-2 md:w-1/3 px-8 py-3 rounded-md text-white font-heading font-semibold hover:bg-coral duration-300">
                Book a call</button>
        </div>

        <img src="/img/lead_forward_logo - Copy.png"
                class="absolute h-20 md:h-48 z-10 rounded-sm bottom-1/3 left-6 md:top-2/3 md:left-1/2 md:-translate-x-1/3 -translate-y-1/2"/>

        <div class="right-pic ">
            <img src="/img/brooke-cagle-JBwcenOuRCg-unsplash.jpg"
